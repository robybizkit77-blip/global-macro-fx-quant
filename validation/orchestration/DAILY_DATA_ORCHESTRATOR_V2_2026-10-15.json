{
  "schema": "GMFQ_DAILY_DATA_ORCHESTRATOR_V2",
  "version": "2026-10-26",
  "status": "ACTIVE_SCHEDULE_CONTRACT",
  "purpose": "Attempt data preparation before 08:00 Europe/Rome, then reverify at 07:45 and catch up at 09:10; never invent unavailable official observations.",
  "timezone": "Europe/Rome",
  "target_local_times": {
    "prebrief": "05:00",
    "premorning": "07:45",
    "morning": "09:10",
    "close": "18:30",
    "night": "00:50"
  },
  "phases": {
    "prebrief": [
      "macro-persistent-daily-v1.yml",
      "rates-persistent-daily-v1.yml",
      "ois-estimated-snapshot-repricing-v1.yml",
      "calendar-news-operational-refresh-v1.yml",
      "vix-persistent-apply-v1.yml",
      "final-e2e-certification-gate-v3.yml",
      "publish-dashboard-pages-v1.yml"
    ],
    "premorning": [
      "calendar-news-operational-refresh-v1.yml",
      "rates-persistent-daily-v1.yml",
      "final-e2e-certification-gate-v3.yml",
      "publish-dashboard-pages-v1.yml"
    ],
    "morning": [
      "macro-persistent-daily-v1.yml",
      "rates-persistent-daily-v1.yml",
      "ois-estimated-snapshot-repricing-v1.yml",
      "liquidity-jpy-m3-persistent-daily-v1.yml",
      "chf-residual-proxy-refresh-v1.yml",
      "jpy-reserve-balances-proxy-refresh-v1.yml",
      "calendar-news-operational-refresh-v1.yml",
      "final-e2e-certification-gate-v3.yml",
      "publish-dashboard-pages-v1.yml"
    ],
    "close": [
      "price-persistent-daily-v1.yml",
      "calendar-news-operational-refresh-v1.yml",
      "final-e2e-certification-gate-v3.yml",
      "publish-dashboard-pages-v1.yml"
    ],
    "night": [
      "vix-persistent-apply-v1.yml",
      "wti-persistent-rebuild-v1.yml",
      "brent-market-proxy-refresh-v1.yml",
      "calendar-news-operational-refresh-v1.yml",
      "final-e2e-certification-gate-v3.yml",
      "publish-dashboard-pages-v1.yml"
    ]
  },
  "separate_cadences": {
    "COT": "cot-persistent-weekly-v1.yml",
    "CB_PRICING_MORNING": "cb-pricing-persistent-daily-v1.yml"
  },
  "rules": {
    "dispatch_ref": "main",
    "strict_sequence": true,
    "stop_on_child_failure": true,
    "reuse_existing_workflows": true,
    "duplicate_collectors_forbidden": true,
    "core_scoring_effect": "NONE",
    "official_promotion_effect": "NONE",
    "cot_remains_weekly": true,
    "final_certification_required_per_phase": true,
    "pages_publish_required_per_phase": true,
    "premorning_avoids_not_yet_ready_sources": true,
    "prebrief_target_before_study": "08:00",
    "prebrief_never_fabricates_missing_publications": true,
    "morning_0910_is_catch_up_not_first_refresh": true,
    "prebrief_recovers_official_previous_close_vix": true,
    "prebrief_cb_pricing_independent_source_outage_isolation": true,
    "premorning_calendar_news_selective_retry": true,
    "morning_0910_cb_independent_source_outage_isolation": true
  }
}

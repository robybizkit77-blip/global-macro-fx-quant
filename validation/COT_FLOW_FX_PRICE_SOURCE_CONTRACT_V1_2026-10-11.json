    "predictor_revision_use": false
  },
  "readiness_gate": {
    "all_seven_series_required": true,
    "each_series_first_nonmissing_on_or_before": "2018-01-03",
    "each_series_minimum_nonmissing_observations_2018_onward": 2000,
    "positive_values_only": true,
    "orientation_transform_must_be_explicit": true,
    "minimum_latest_common_nonmissing_date": "2026-09-01"
  },
  "governance": {
    "no_alternative_price_source_after_edge_results": true,
    "no_source_blending": true,
    "no_price_interpolation": true,

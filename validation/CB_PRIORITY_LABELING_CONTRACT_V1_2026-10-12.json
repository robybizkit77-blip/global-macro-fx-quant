  },
  "text_normalization": {
    "strip_navigation_footer_scripts_styles": true,
    "preserve_sentence_order": true,
    "no_translation_required_for_english_official_source": true,
    "boJ_english_official_text_only": true
  },
  "topic_terms": {
    "INFLATION": ["inflation","price stability","price pressures","underlying inflation","core inflation","wage pressures","wages","prices"],
    "LABOUR_GROWTH": ["employment","unemployment","labour market","labor market","jobs","growth","economic activity","activity","demand","output","recession","downturn"],
    "FINANCIAL_STABILITY_OTHER": ["financial stability","market functioning","financial conditions disruption","exchange rate intervention","liquidity stress"]
  },
  "policy_relevance_cues": ["in view of","because","therefore","appropriate","necessary","need to","requires","warrant","concern","risk","risks","monitor","monitoring","focus","focused","objective","mandate","outlook","guidance","stance"],
  "explicit_dominance_cues": ["primary concern","main concern","principal concern","focus is","focused on","priority is","particularly concerned","especially concerned","most important"],
  "mechanical_label_rule": {
    "unit": "sentence",
    "qualifying_sentence": "sentence contains at least one topic term and at least one policy-relevance cue, or contains an explicit-dominance cue adjacent to a topic term",
    "topic_score": "number of distinct qualifying sentences supporting each topic family",
    "explicit_dominance_precedence": true,
    "financial_stability_other_rule": "FINANCIAL_STABILITY_OTHER only when an explicit-dominance cue supports that topic; otherwise it cannot displace inflation or labour/growth",
    "inflation_rule": "INFLATION when inflation has explicit dominance, or inflation topic_score >=2 and exceeds labour_growth topic_score by >=2",
    "labour_growth_rule": "LABOUR_GROWTH when labour/growth has explicit dominance, or labour_growth topic_score >=2 and exceeds inflation topic_score by >=2",
    "balanced_rule": "BALANCED when inflation and labour/growth each have at least one qualifying sentence and neither primary rule wins",
    "withheld_rule": "WITHHELD_AMBIGUOUS when no reproducible primary/balanced assignment is possible",
    "tie_break_by_market_outcome": "forbidden",
    "tie_break_by_future_policy": "forbidden"
  },
  "required_label_row_fields": ["central_bank","decision_date","publication_timestamp","source_url","source_document_type","focus_primary","focus_evidence","inflation_topic_score","labour_growth_topic_score","financial_stability_other_topic_score","explicit_dominance_topic","label_method_version","pit_eligible"],

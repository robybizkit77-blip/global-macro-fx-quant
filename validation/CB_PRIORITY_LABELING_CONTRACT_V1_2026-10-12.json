  "purpose": "Assign central-bank primary policy priority from contemporaneous official decision text before any FX/rates performance is computed.",
  "allowed_labels": ["INFLATION","BALANCED","LABOUR_GROWTH","FINANCIAL_STABILITY_OTHER","WITHHELD_AMBIGUOUS"],
  "document_boundary": {
    "official_decision_document_only": true,
    "same_event_official_opening_material_allowed_only_if_linked_in_inventory": true,
    "later_minutes_forbidden": true,
    "later_speeches_forbidden": true,
    "later_macro_forbidden": true,
